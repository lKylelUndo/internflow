# Server
APP_NAME="Internflow API"
PORT=8000
NODE_ENV=development
DATABASE_URL="postgresql connection string (local Postgres or Neon.com)"
REDIS_URL="redis://localhost:6379"
BACKEND_URL="http://localhost:8000"

# JWT: Generate yours at https://jwtsecrets.com/
# Both are REQUIRED in production — the server refuses to boot without them.
JWT_SECRET=
JWT_REFRESH_SECRET=

# FRONTEND
FRONTEND_URL="http://localhost:3000"
