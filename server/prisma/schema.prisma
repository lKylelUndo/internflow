// Internflow schema — all models live in this file.
// Header mirrors alumnai: Prisma 7 generates the client into src/generated/prisma
// (gitignored), and the datasource URL comes from prisma.config.ts (DATABASE_URL in .env).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Starter model — replace/extend with your own domain models.
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
